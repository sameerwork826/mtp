
# Initialization
units           lj
atom_style      full
boundary        p p p
read_data C:\Users\nande\Desktop\mtp\case_3_og\data_files\charge_2\ps_c_10_28.data

# Force field definitions 
bond_style      fene
bond_coeff      1 30.0 1.5 1.0 1.0 # k=30, r0=1.5, e=1, sigma=1

# Non-bonded interactions: LJ + Coulombic
pair_style      lj/cut/coul/long 2.5 10.0
pair_modify     shift yes

# Initial interaction parameters
pair_coeff      * * 1.0 1.0

# Coulombic solver
kspace_style    pppm 1.0e-4
dielectric      1.0

special_bonds   lj 0.0 1.0 1.0 coul 0.0 1.0 1.0

# Neighbor lists
neighbor        0.5 bin 
neigh_modify    one 10000 every 1 delay 1 check yes

# System groups
group           type_A type 1
group           type_B type 2

# Energy minimization
minimize        1.0e-4 1.0e-6 1000 10000

# Set up time integration
timestep        0.005

# Temperature control
variable        temp equal 2.0
fix 1 all langevin ${temp} ${temp} 2.0 12680
fix             2 all nve

# Output settings
thermo_style    custom step pe ke temp press
thermo          1000

# ---- EQUILIBRATION RUN ----
dump eq_dump all custom 1000 equilibration_28_3.lammpstrj id type q xu yu zu 
dump_modify     eq_dump sort id 

run             50000
undump          eq_dump
reset_timestep 0

# Ready for production run 


# Compute gyration
compute     rg_all all gyration

# MSD for dynamics
compute         msd_all all msd com yes

# ---- OUTPUT FILES ----

# #RG output
fix rg_avg_all all ave/time 100 1 100 c_rg_all file rg_all_28_3.dat
# # MSD for diffusion
fix             msd_avg_all all ave/time 50 1 50 c_msd_all[4] file msd_all_28_3.dat mode scalar

# ---- PRODUCTION RUN ----
dump prod_dump all custom 1000 production_28_3.lammpstrj id type q x y z 
dump_modify     prod_dump sort id

run             100000


